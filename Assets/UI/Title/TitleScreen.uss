/* ==========================================================================
   TitleScreen.uss
   Painted-illustration main menu. The shop interior painting is bound at
   runtime to #bgImage from TitleScreenController.backgroundImage; everything
   else is procedural so the screen still composes if the texture is missing.
   ========================================================================== */

/* ── Palette tokens ─────────────────────────────────────────────────────── */
:root {
    --parchment-base:    rgb(232, 213, 178);
    --parchment-warm:    rgb(217, 192, 150);
    --ink-dark:          rgb(46, 32, 22);
    --ink-soft:          rgb(86, 64, 44);
    --ink-light:         rgb(245, 230, 200);
    --ink-light-soft:    rgba(245, 230, 200, 0.78);
    --gold-leaf:         rgb(214, 178, 112);
    --shadow-deep:       rgba(20, 12, 4, 0.85);
    --shadow-soft:       rgba(20, 12, 4, 0.55);
}

/* ── Root: full-screen plate ────────────────────────────────────────────── */
.root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(28, 18, 10);
    -unity-font-style: normal;
}

/* Painted illustration; texture assigned from C#. scale-and-crop keeps the
   focal point centred without stretching across aspect ratios. */
.bg-image {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgb(28, 18, 10);
}

/* ── Content column ─────────────────────────────────────────────────────── */
.content {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center;
    justify-content: flex-start;
    padding-top: 200px;
}

/* ── Title block: stacked serif title + underline + tagline ────────────── */
.title-block {
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.title-text {
    -unity-text-align: middle-center;
    color: rgb(70, 44, 24);
    font-size: 116px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    margin: 0;
    white-space: normal;
    text-shadow: 1px 2px 4px rgba(232, 213, 178, 0.55);
}

/* Decorative ink rule under the title. */
.title-underline {
    width: 320px;
    height: 2px;
    background-color: rgba(70, 44, 24, 0.65);
    margin-top: 14px;
    margin-bottom: 14px;
    border-radius: 1px;
}

/* ── Tagline ───────────────────────────────────────────────────────────── */
.tagline-text {
    -unity-text-align: middle-center;
    color: rgb(86, 56, 32);
    font-size: 22px;
    -unity-font-style: italic;
    letter-spacing: 1px;
    text-shadow: 1px 1px 3px rgba(232, 213, 178, 0.55);
}

/* ── Button stack ──────────────────────────────────────────────────────── */
.button-stack {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-top: 28px;
}

.menu-button {
    -unity-text-align: middle-center;
    color: rgb(70, 44, 24);
    background-color: rgba(20, 12, 4, 0);
    background-image: none;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    font-size: 40px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    padding-left: 22px;
    padding-right: 22px;
    padding-top: 4px;
    padding-bottom: 4px;
    margin-top: 4px;
    margin-bottom: 4px;
    text-shadow: 1px 1px 3px rgba(232, 213, 178, 0.55);
    transition-property: color, scale, translate;
    transition-duration: 120ms;
    transition-timing-function: ease-out;
}

.menu-button:hover {
    color: rgb(150, 100, 48);
    scale: 1.04 1.04;
}

.menu-button:focus {
    color: rgb(150, 100, 48);
}

.menu-button:active {
    color: rgb(70, 44, 24);
    translate: 0 2px;
    scale: 0.98 0.98;
}

/* ── Version stamp ─────────────────────────────────────────────────────── */
.version-text {
    position: absolute;
    right: 28px;
    bottom: 22px;
    color: rgba(70, 44, 24, 0.75);
    font-size: 14px;
    letter-spacing: 1px;
    -unity-font-style: italic;
    text-shadow: 1px 1px 2px rgba(232, 213, 178, 0.55);
}

/* ── Developer modal ───────────────────────────────────────────────────── */
.modal {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center;
    justify-content: center;
}

.modal.hidden {
    display: none;
}

.modal-backdrop {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(20, 12, 4, 0.65);
}

.modal-card {
    width: 480px;
    padding-left: 36px;
    padding-right: 36px;
    padding-top: 32px;
    padding-bottom: 28px;
    background-color: rgb(232, 213, 178);
    border-radius: 6px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(110, 78, 36, 0.55);
    border-right-color: rgba(110, 78, 36, 0.55);
    border-top-color: rgba(110, 78, 36, 0.55);
    border-bottom-color: rgba(110, 78, 36, 0.55);
    align-items: center;
    justify-content: flex-start;
}

.modal-heading {
    -unity-text-align: middle-center;
    color: rgb(46, 32, 22);
    font-size: 34px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 6px;
}

.modal-rule {
    width: 220px;
    height: 1px;
    background-color: rgba(46, 32, 22, 0.45);
    margin-bottom: 18px;
    border-radius: 1px;
}

.modal-line {
    -unity-text-align: middle-center;
    color: rgb(46, 32, 22);
    font-size: 20px;
    letter-spacing: 1px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.modal-close-button {
    -unity-text-align: middle-center;
    color: rgb(46, 32, 22);
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 4px;
    padding-bottom: 4px;
    margin-top: 22px;
    transition-property: color, scale, translate;
    transition-duration: 120ms;
    transition-timing-function: ease-out;
}

.modal-close-button:hover {
    color: rgb(150, 116, 60);
    scale: 1.05 1.05;
}

.modal-close-button:focus {
    color: rgb(150, 116, 60);
}

.modal-close-button:active {
    color: rgb(46, 32, 22);
    translate: 0 1px;
    scale: 0.98 0.98;
}
