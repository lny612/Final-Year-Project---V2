/* ==========================================================================
   MaterialMarket.uss
   Cozy storybook market: warm walnut bench framing parchment cards. The
   topbar is a wood plank with a carved title nameplate and a heart-and-coin
   gold badge. The body is split into a left categories+memo column and a
   right scrolling grid of material cards. Selected categories light up in
   coral, and bought cards get a coral "Bought" stamp across the artwork.
   ========================================================================== */

/* ── Palette tokens ─────────────────────────────────────────────────────── */
:root {
    --wood-base:        rgb(72, 46, 28);
    --wood-deep:        rgb(54, 32, 18);
    --wood-warm:        rgb(110, 72, 40);
    --wood-shadow:      rgb(36, 22, 12);

    --parchment-base:   rgb(232, 213, 178);
    --parchment-warm:   rgb(217, 192, 150);
    --parchment-deep:   rgb(190, 160, 112);
    --parchment-edge:   rgba(110, 78, 36, 0.55);
    --parchment-rule:   rgba(46, 32, 22, 0.45);

    --ink-dark:         rgb(46, 32, 22);
    --ink-soft:         rgb(86, 64, 44);
    --ink-faded:        rgba(46, 32, 22, 0.55);
    --ink-cream:        rgb(245, 230, 200);

    --brass:            rgb(190, 148, 70);
    --gold-leaf:        rgb(214, 178, 112);
    --gold-warm:        rgb(232, 188, 96);

    --coral:            rgb(198, 84, 52);
    --coral-soft:       rgb(212, 110, 78);
    --coral-deep:       rgb(160, 60, 32);
    --heart-red:        rgb(214, 76, 60);
}

/* ── Root: full-screen wood plate ───────────────────────────────────────── */
.market-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(54, 32, 18);
    -unity-font-definition: url("project://database/Assets/Fonts/The%20Garden%20of%20Lights.ttf");
    -unity-font-style: normal;
}

.market-wood-plate {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgb(72, 46, 28);
}

.market-wood-grain {
    position: absolute;
    left: 4%; right: 4%; top: 3%; bottom: 3%;
    background-color: rgba(36, 22, 12, 0.18);
    border-left-width:   1px;
    border-right-width:  1px;
    border-top-width:    1px;
    border-bottom-width: 1px;
    border-left-color:   rgba(36, 22, 12, 0.35);
    border-right-color:  rgba(36, 22, 12, 0.35);
    border-top-color:    rgba(36, 22, 12, 0.45);
    border-bottom-color: rgba(36, 22, 12, 0.45);
    border-radius: 6px;
}

.market-vignette {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    border-left-width:   38px;
    border-right-width:  38px;
    border-top-width:    32px;
    border-bottom-width: 32px;
    border-left-color:   rgba(36, 22, 12, 0.65);
    border-right-color:  rgba(36, 22, 12, 0.65);
    border-top-color:    rgba(36, 22, 12, 0.55);
    border-bottom-color: rgba(36, 22, 12, 0.75);
}

/* ── Top bar ────────────────────────────────────────────────────────────── */
.market-topbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 92px;
    margin-left: 56px;
    margin-right: 56px;
    margin-top: 18px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgb(110, 72, 40);
    border-left-width:   3px;
    border-right-width:  3px;
    border-top-width:    3px;
    border-bottom-width: 3px;
    border-left-color:   rgba(36, 22, 12, 0.85);
    border-right-color:  rgba(36, 22, 12, 0.85);
    border-top-color:    rgba(36, 22, 12, 0.65);
    border-bottom-color: rgba(36, 22, 12, 0.95);
    border-radius: 14px;
}

.market-back {
    width: 56px;
    height: 56px;
    background-color: rgb(232, 213, 178);
    background-image: none;
    border-left-width:   2px;
    border-right-width:  2px;
    border-top-width:    2px;
    border-bottom-width: 2px;
    border-left-color:   rgba(36, 22, 12, 0.85);
    border-right-color:  rgba(36, 22, 12, 0.85);
    border-top-color:    rgba(36, 22, 12, 0.65);
    border-bottom-color: rgba(36, 22, 12, 0.95);
    border-radius: 10px;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(46, 32, 22);
    transition-property: scale, translate, background-color;
    transition-duration: 120ms;
    transition-timing-function: ease-out;
}
.market-back:hover  { background-color: rgb(245, 230, 200); scale: 1.04 1.04; }
.market-back:active { background-color: rgb(190, 160, 112); translate: 0 1px; scale: 0.98 0.98; }

.market-title-plate {
    flex-grow: 1;
    height: 60px;
    margin-left: 14px;
    margin-right: 14px;
    align-items: center;
    justify-content: center;
    background-color: rgb(54, 32, 18);
    border-left-width:   2px;
    border-right-width:  2px;
    border-top-width:    2px;
    border-bottom-width: 2px;
    border-left-color:   rgba(214, 178, 112, 0.65);
    border-right-color:  rgba(214, 178, 112, 0.65);
    border-top-color:    rgba(214, 178, 112, 0.65);
    border-bottom-color: rgba(214, 178, 112, 0.65);
    border-radius: 10px;
}

.market-title {
    color: rgb(245, 230, 200);
    font-size: 26px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    text-shadow: 1px 2px 4px rgba(20, 12, 4, 0.85);
}

.market-gold {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 60px;
    padding-left: 12px;
    padding-right: 18px;
    background-color: rgb(232, 213, 178);
    border-left-width:   2px;
    border-right-width:  2px;
    border-top-width:    2px;
    border-bottom-width: 2px;
    border-left-color:   rgba(36, 22, 12, 0.85);
    border-right-color:  rgba(36, 22, 12, 0.85);
    border-top-color:    rgba(36, 22, 12, 0.65);
    border-bottom-color: rgba(36, 22, 12, 0.95);
    border-radius: 10px;
}

/* Brass coin disc with a darker rim. */
.market-gold-icon {
    width: 28px;
    height: 28px;
    margin-right: 10px;
    background-color: rgb(232, 188, 96);
    border-left-width:   2px;
    border-right-width:  2px;
    border-top-width:    2px;
    border-bottom-width: 2px;
    border-left-color:   rgb(150, 100, 28);
    border-right-color:  rgb(150, 100, 28);
    border-top-color:    rgb(150, 100, 28);
    border-bottom-color: rgb(150, 100, 28);
    border-radius: 50%;
}

.gold-amount {
    color: rgb(46, 32, 22);
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.market-gold.gold-flash {
    background-color: rgb(214, 76, 60);
}

/* ── Body: left column + scrollable card grid ───────────────────────────── */
.market-body {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
    justify-content: flex-start;
    margin-left: 56px;
    margin-right: 56px;
    margin-top: 14px;
    margin-bottom: 8px;
}

/* ── LEFT column: categories + memo ─────────────────────────────────────── */
.market-left {
    width: 300px;
    flex-shrink: 0;
    flex-direction: column;
    align-items: stretch;
    margin-right: 16px;
}

.market-categories {
    background-color: rgb(232, 213, 178);
    border-left-width:   2px;
    border-right-width:  2px;
    border-top-width:    2px;
    border-bottom-width: 2px;
    border-left-color:   rgba(110, 78, 36, 0.55);
    border-right-color:  rgba(110, 78, 36, 0.55);
    border-top-color:    rgba(110, 78, 36, 0.55);
    border-bottom-color: rgba(110, 78, 36, 0.55);
    border-radius: 8px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 6px;
    padding-right: 6px;
    margin-bottom: 14px;
}

.market-cat {
    color: rgb(46, 32, 22);
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-left-width:   0;
    border-right-width:  0;
    border-top-width:    0;
    border-bottom-width: 0;
    border-radius: 6px;
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-left;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 10px;
    padding-bottom: 10px;
    margin-top: 2px;
    margin-bottom: 2px;
    transition-property: background-color, color, scale, translate;
    transition-duration: 120ms;
    transition-timing-function: ease-out;
}
.market-cat:hover {
    color: rgb(160, 60, 32);
    background-color: rgba(198, 84, 52, 0.12);
    translate: 2px 0;
}
.market-cat:active {
    background-color: rgba(160, 60, 32, 0.20);
    translate: 0 1px;
}

.market-cat--selected {
    color: rgb(245, 230, 200);
    background-color: rgb(198, 84, 52);
    border-left-width:   2px;
    border-right-width:  2px;
    border-top-width:    2px;
    border-bottom-width: 2px;
    border-left-color:   rgb(160, 60, 32);
    border-right-color:  rgb(160, 60, 32);
    border-top-color:    rgb(160, 60, 32);
    border-bottom-color: rgb(160, 60, 32);
    text-shadow: 1px 1px 3px rgba(20, 12, 4, 0.65);
}
.market-cat--selected:hover {
    color: rgb(245, 230, 200);
    background-color: rgb(212, 110, 78);
    translate: 2px 0;
}

.market-cat-divider {
    height: 1px;
    margin-left: 22px;
    margin-right: 22px;
    background-color: rgba(110, 78, 36, 0.45);
    border-radius: 1px;
}

/* Memo card under the categories. */
.market-memo-panel {
    background-color: rgb(232, 213, 178);
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 16px;
    padding-bottom: 16px;
    border-left-width:   2px;
    border-right-width:  2px;
    border-top-width:    2px;
    border-bottom-width: 2px;
    border-left-color:   rgba(110, 78, 36, 0.55);
    border-right-color:  rgba(110, 78, 36, 0.55);
    border-top-color:    rgba(110, 78, 36, 0.55);
    border-bottom-color: rgba(110, 78, 36, 0.55);
    border-radius: 8px;
}

.memo-heading {
    color: rgb(46, 32, 22);
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.memo-rule {
    width: 80%;
    height: 1px;
    background-color: rgba(46, 32, 22, 0.45);
    align-self: center;
    margin-top: 4px;
    margin-bottom: 8px;
    border-radius: 1px;
}

.memo-slot {
    flex-direction: column;
    margin-top: 6px;
    margin-bottom: 6px;
}

.memo-label {
    color: rgba(86, 64, 44, 0.85);
    font-size: 13px;
    letter-spacing: 2px;
    -unity-font-style: italic;
    margin-bottom: 2px;
}

.memo-value {
    color: rgb(46, 32, 22);
    font-size: 16px;
    -unity-font-style: bold;
    white-space: normal;
}

.memo-footnote {
    color: rgba(86, 64, 44, 0.75);
    font-size: 12px;
    -unity-font-style: italic;
    letter-spacing: 1px;
    margin-top: 12px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ── RIGHT: scrollable card grid ────────────────────────────────────────── */
.market-cards {
    flex-grow: 1;
    background-color: rgba(232, 213, 178, 0.0);
}

.market-cards > .unity-scroll-view__content-container {
    flex-direction: column;
}

.market-card-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: flex-start;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
}

.market-card-row.hidden {
    display: none;
}

/* ── Card ───────────────────────────────────────────────────────────────── */
.material-card {
    /* The card's parent is a TemplateContainer that MaterialMarketUI.AddCard
       gives `flexGrow=1, flexBasis=0` inline, so the three TemplateContainers
       split the row width evenly. The card itself just fills its container
       horizontally. We must NOT set flex-basis: 0 here — the TemplateContainer
       defaults to flex-direction: column, so flex-basis affects HEIGHT, and
       collapsing the card's height to 0 hides the whole panel. */
    width: 100%;
    min-width: 240px;
    flex-grow: 0;
    flex-shrink: 1;
    /* 5px on every side so adjacent cards leave ~10px between them in any
       direction (row-flow horizontal AND wrapped-row vertical). */
    margin-left: 5px;
    margin-right: 5px;
    margin-top: 5px;
    margin-bottom: 5px;
    background-color: rgb(232, 213, 178);
    border-left-width:   2px;
    border-right-width:  2px;
    border-top-width:    2px;
    border-bottom-width: 2px;
    border-left-color:   rgba(110, 78, 36, 0.55);
    border-right-color:  rgba(110, 78, 36, 0.55);
    border-top-color:    rgba(110, 78, 36, 0.55);
    border-bottom-color: rgba(110, 78, 36, 0.55);
    border-radius: 10px;
    align-items: stretch;
    overflow: hidden;
    transition-property: translate, scale;
    transition-duration: 120ms;
    transition-timing-function: ease-out;
}
.material-card:hover {
    translate: 0 -3px;
}

/* Wood-tone nameplate header. */
.card-nameplate {
    align-items: center;
    justify-content: center;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 13px;
    padding-bottom: 13px;
    background-color: rgb(110, 72, 40);
    border-bottom-width: 2px;
    border-bottom-color: rgba(36, 22, 12, 0.65);
}

.card-name {
    color: rgb(245, 230, 200);
    font-size: 48px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    white-space: normal;
    text-shadow: 1px 1px 3px rgba(20, 12, 4, 0.85);
}

.card-subline {
    color: rgb(198, 84, 52);
    font-size: 36px;
    -unity-font-style: italic;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    margin-top: 8px;
    margin-bottom: 6px;
}

/* Art well — parchment background, the painted material illustration sits
   centred inside it. The placeholder shows while ComfyUI is generating. */
.card-art {
    height: 224px;
    margin-left: 14px;
    margin-right: 14px;
    margin-top: 6px;
    margin-bottom: 8px;
    background-color: rgb(245, 230, 200);
    border-left-width:   1px;
    border-right-width:  1px;
    border-top-width:    1px;
    border-bottom-width: 1px;
    border-left-color:   rgba(110, 78, 36, 0.45);
    border-right-color:  rgba(110, 78, 36, 0.45);
    border-top-color:    rgba(110, 78, 36, 0.45);
    border-bottom-color: rgba(110, 78, 36, 0.45);
    border-radius: 6px;
    align-items: center;
    justify-content: center;
}

.card-placeholder {
    position: absolute;
    width: 70%;
    height: 70%;
    background-color: rgba(190, 160, 112, 0.45);
    border-radius: 6px;
}

.card-image {
    position: absolute;
    left: 4px; right: 4px; top: 4px; bottom: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.card-hint-glyph {
    position: absolute;
    right: 6px;
    top: 6px;
    color: rgb(214, 178, 112);
    font-size: 18px;
    -unity-font-style: bold;
    text-shadow: 1px 1px 3px rgba(20, 12, 4, 0.65);
}

/* "Bought" diagonal stamp — coral, rotated, shown only when sold-out. */
.card-soldout {
    position: absolute;
    width: 80%;
    align-self: center;
    color: rgb(245, 230, 200);
    background-color: rgb(160, 60, 32);
    border-left-width:   2px;
    border-right-width:  2px;
    border-top-width:    2px;
    border-bottom-width: 2px;
    border-left-color:   rgba(20, 12, 4, 0.65);
    border-right-color:  rgba(20, 12, 4, 0.65);
    border-top-color:    rgba(20, 12, 4, 0.65);
    border-bottom-color: rgba(20, 12, 4, 0.65);
    border-radius: 4px;
    font-size: 44px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    -unity-text-align: middle-center;
    padding-top: 10px;
    padding-bottom: 10px;
    rotate: -10deg;
    display: none;
    text-shadow: 1px 1px 3px rgba(20, 12, 4, 0.85);
}

.card-attributes {
    flex-direction: column;
    margin-left: 12px;
    margin-right: 12px;
    margin-bottom: 4px;
}

.card-field {
    color: rgb(46, 32, 22);
    font-size: 33px;
    -unity-text-align: middle-left;
    margin-top: 4px;
    margin-bottom: 4px;
    white-space: normal;
}

.card-field-primary {
    -unity-font-style: bold;
}

/* Footer: heart-style coin + price · brass Buy button. */
.card-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(255, 255, 255, 0.0);
    margin-left: 12px;
    margin-right: 12px;
    margin-top: 4px;
    margin-bottom: 10px;
    padding-top: 6px;
    padding-bottom: 0;
    border-top-width: 1px;
    border-top-color: rgba(110, 78, 36, 0.35);
}

.card-price {
    flex-direction: row;
    align-items: center;
}

.card-coin-icon {
    width: 18px;
    height: 18px;
    margin-right: 6px;
    background-color: rgb(232, 188, 96);
    border-left-width:   2px;
    border-right-width:  2px;
    border-top-width:    2px;
    border-bottom-width: 2px;
    border-left-color:   rgb(150, 100, 28);
    border-right-color:  rgb(150, 100, 28);
    border-top-color:    rgb(150, 100, 28);
    border-bottom-color: rgb(150, 100, 28);
    border-radius: 50%;
}

.card-price-amount {
    color: rgb(46, 32, 22);
    font-size: 32px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.card-buy {
    color: rgb(46, 32, 22);
    background-color: rgb(214, 178, 112);
    background-image: none;
    border-left-width:   2px;
    border-right-width:  2px;
    border-top-width:    2px;
    border-bottom-width: 2px;
    border-left-color:   rgba(110, 78, 36, 0.65);
    border-right-color:  rgba(110, 78, 36, 0.65);
    border-top-color:    rgba(110, 78, 36, 0.65);
    border-bottom-color: rgba(110, 78, 36, 0.65);
    border-radius: 6px;
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 4px;
    padding-bottom: 4px;
    transition-property: background-color, scale, translate;
    transition-duration: 120ms;
    transition-timing-function: ease-out;
}
.card-buy:hover  { background-color: rgb(232, 196, 130); scale: 1.04 1.04; }
.card-buy:active { background-color: rgb(190, 148, 70); translate: 0 1px; scale: 0.97 0.97; }
.card-buy:disabled {
    color: rgba(46, 32, 22, 0.35);
    background-color: rgba(190, 148, 70, 0.35);
    border-left-color:   rgba(110, 78, 36, 0.25);
    border-right-color:  rgba(110, 78, 36, 0.25);
    border-top-color:    rgba(110, 78, 36, 0.25);
    border-bottom-color: rgba(110, 78, 36, 0.25);
}

/* Sold-out: dim the art well, hide the buy button, reveal the stamp. */
.material-card.sold-out .card-art    { opacity: 0.55; }
.material-card.sold-out .card-buy    { display: none; }
.material-card.sold-out .card-soldout { display: flex; }

/* ── Footer (bottom bar) ────────────────────────────────────────────────── */
.market-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-left: 56px;
    margin-right: 56px;
    margin-bottom: 18px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: rgba(54, 32, 18, 0.65);
    border-left-width:   2px;
    border-right-width:  2px;
    border-top-width:    2px;
    border-bottom-width: 2px;
    border-left-color:   rgba(214, 178, 112, 0.45);
    border-right-color:  rgba(214, 178, 112, 0.45);
    border-top-color:    rgba(214, 178, 112, 0.45);
    border-bottom-color: rgba(214, 178, 112, 0.45);
    border-radius: 8px;
}

.market-status {
    color: rgba(245, 230, 200, 0.85);
    font-size: 14px;
    -unity-font-style: italic;
    letter-spacing: 1px;
    text-shadow: 1px 1px 3px rgba(20, 12, 4, 0.85);
    flex-grow: 1;
    -unity-text-align: middle-left;
    padding-left: 8px;
    white-space: normal;
}

.market-proceed {
    color: rgb(46, 32, 22);
    background-color: rgb(214, 178, 112);
    background-image: none;
    border-left-width:   2px;
    border-right-width:  2px;
    border-top-width:    2px;
    border-bottom-width: 2px;
    border-left-color:   rgba(110, 78, 36, 0.65);
    border-right-color:  rgba(110, 78, 36, 0.65);
    border-top-color:    rgba(110, 78, 36, 0.65);
    border-bottom-color: rgba(110, 78, 36, 0.65);
    border-radius: 6px;
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 8px;
    padding-bottom: 8px;
    transition-property: background-color, scale, translate;
    transition-duration: 120ms;
    transition-timing-function: ease-out;
}
.market-proceed:hover  { background-color: rgb(232, 196, 130); scale: 1.03 1.03; }
.market-proceed:active { background-color: rgb(190, 148, 70); translate: 0 1px; scale: 0.98 0.98; }
.market-proceed:disabled {
    color: rgba(46, 32, 22, 0.45);
