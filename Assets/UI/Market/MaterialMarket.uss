/* =====================================================================
   MaterialMarket.uss
   Cozy parchment / wood styling for the buying & purchasing screen.
   Visual targets: Assets/UI references/buying & purchase 1.jpg & 2.jpg
   ===================================================================== */

/* ------------ tokens ------------------------------------------------- */
:root {
    --col-parchment:       rgb(245, 233, 210);
    --col-parchment-dark:  rgb(232, 216, 181);
    --col-parchment-edge:  rgb(214, 196, 158);
    --col-wood:            rgb(142, 106, 65);
    --col-wood-dark:       rgb(93,  68,  39);
    --col-wood-light:      rgb(180, 145, 100);
    --col-nameplate:       rgb(232, 185, 107);
    --col-nameplate-dark:  rgb(184, 137, 64);
    --col-card-bg:         rgb(250, 241, 220);
    --col-ink:             rgb(76,  54,  33);
    --col-ink-soft:        rgb(122, 92,  61);
    --col-coin:            rgb(212, 162, 59);
    --col-coin-rim:        rgb(150, 105, 30);
    --col-flash-red:       rgb(194, 75,  58);
    --col-glyph:           rgb(199, 125, 255);
    --col-buy:             rgb(196, 99,  72);
    --col-buy-hover:       rgb(214, 116, 89);
    --col-buy-press:       rgb(165, 78,  56);
}

/* ------------ root --------------------------------------------------- */
.market-root {
    flex-grow: 1;
    flex-direction: column;
    background-color: var(--col-parchment);
    color: var(--col-ink);
    font-size: 16px;
    -unity-font-style: normal;
    /* TODO-EDITOR: drop a TTF (e.g. PatrickHand-Regular) into Assets/Fonts/
       and uncomment the next line, pointing at it, for the cozy hand-drawn feel:
       --unity-font-definition: url("project://database/Assets/Fonts/PatrickHand-Regular.ttf");
    */
    padding: 12px;
}

/* ------------ top bar ----------------------------------------------- */
.market-topbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 78px;
    padding: 8px 16px;
    background-color: var(--col-wood);
    border-radius: 18px;
    border-width: 3px;
    border-color: var(--col-wood-dark);
    margin-bottom: 12px;
}

.market-back {
    width: 56px;
    height: 56px;
    background-color: var(--col-parchment);
    color: var(--col-ink);
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--col-wood-dark);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

.market-back:hover {
    background-color: rgb(255, 245, 222);
    translate: 0 -2px;
}

.market-back:active {
    background-color: var(--col-parchment-dark);
    translate: 0 0;
}

.market-title-plate {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 56px;
    margin: 0 16px;
    background-color: var(--col-wood-light);
    border-radius: 14px;
    border-width: 2px;
    border-color: var(--col-wood-dark);
}

.market-title {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(245, 235, 215);
    letter-spacing: 4px;
    -unity-text-align: middle-center;
}

.market-gold {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    background-color: var(--col-parchment);
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--col-wood-dark);
    padding: 6px 14px 6px 8px;
    min-width: 110px;
    height: 56px;
    transition-property: background-color, color;
    transition-duration: 200ms;
}

.market-gold.gold-flash {
    background-color: var(--col-flash-red);
}

.market-gold.gold-flash .gold-amount {
    color: rgb(255, 245, 222);
}

.coin-icon {
    width: 22px;
    height: 22px;
    background-color: var(--col-coin);
    border-radius: 11px;
    border-width: 2px;
    border-color: var(--col-coin-rim);
    margin-right: 8px;
}

.coin-icon-small {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    margin-right: 6px;
}

.gold-amount {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--col-ink);
    -unity-text-align: middle-center;
}

/* ------------ body --------------------------------------------------- */
.market-body {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
}

.market-memo-panel {
    width: 280px;
    flex-shrink: 0;
    flex-direction: column;
    background-color: var(--col-parchment-dark);
    border-radius: 14px;
    border-width: 2px;
    border-color: var(--col-parchment-edge);
    padding: 18px 16px;
    margin-right: 14px;
}

.memo-heading {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--col-ink);
    -unity-text-align: middle-center;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom-width: 2px;
    border-bottom-color: var(--col-parchment-edge);
}

.memo-slot {
    flex-direction: column;
    background-color: var(--col-card-bg);
    border-radius: 10px;
    border-width: 2px;
    border-color: var(--col-parchment-edge);
    padding: 10px 12px;
    margin-bottom: 10px;
}

.memo-label {
    font-size: 12px;
    color: var(--col-ink-soft);
    letter-spacing: 1px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.memo-value {
    font-size: 18px;
    color: var(--col-ink);
    -unity-font-style: bold;
    white-space: normal;
}

.memo-footnote {
    margin-top: auto;
    font-size: 12px;
    color: var(--col-ink-soft);
    -unity-font-style: italic;
    white-space: normal;
    padding-top: 8px;
}

/* ------------ cards area -------------------------------------------- */
.market-cards {
    flex-grow: 1;
    flex-direction: column;
}

.market-section-label {
    font-size: 14px;
    color: var(--col-ink-soft);
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    margin: 4px 0 8px 0;
}

.market-card-row {
    flex-direction: row;
    flex-grow: 1;
    margin-bottom: 8px;
}

/* ------------ card --------------------------------------------------- */
.material-card {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    background-color: var(--col-card-bg);
    border-radius: 14px;
    border-width: 2px;
    border-color: var(--col-wood-dark);
    margin: 0 6px;
    padding: 0 0 12px 0;
    overflow: hidden;
    transition-property: translate, border-color, opacity;
    transition-duration: 150ms;
}

.material-card:hover {
    translate: 0 -3px;
    border-color: var(--col-wood);
}

.material-card.sold-out {
    opacity: 0.55;
    border-color: var(--col-parchment-edge);
}

.card-nameplate {
    background-color: var(--col-nameplate);
    border-bottom-width: 2px;
    border-bottom-color: var(--col-nameplate-dark);
    padding: 8px 12px;
    align-items: center;
    justify-content: center;
}

.card-name {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--col-ink);
    -unity-text-align: middle-center;
    white-space: normal;
}

.card-subline {
    font-size: 12px;
    color: var(--col-ink-soft);
    -unity-text-align: middle-center;
    -unity-font-style: italic;
    margin: 6px 8px 4px 8px;
    letter-spacing: 2px;
}

.card-art {
    width: 100%;
    height: 130px;
    align-items: center;
    justify-content: center;
    background-color: rgb(255, 250, 235);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--col-parchment-edge);
    margin-bottom: 8px;
    overflow: hidden;
}

.card-placeholder {
    position: absolute;
    width: 60%;
    height: 60%;
    background-color: var(--col-parchment-dark);
    border-radius: 10px;
    border-width: 2px;
    border-color: var(--col-parchment-edge);
    opacity: 0.7;
}

.card-image {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: none;
    -unity-background-scale-mode: scale-to-fit;
}

.card-hint-glyph {
    position: absolute;
    top: 6px;
    right: 8px;
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--col-glyph);
    display: none;
}

.card-attributes {
    flex-direction: column;
    padding: 0 12px;
    flex-grow: 1;
}

.card-field {
    font-size: 12px;
    color: var(--col-ink-soft);
    white-space: normal;
    margin-bottom: 4px;
    -unity-text-align: upper-left;
}

.card-field-primary {
    color: var(--col-ink);
    -unity-font-style: bold;
}

.card-field.hidden {
    display: none;
}

.card-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px 0 12px;
    margin-top: auto;
}

.card-price {
    flex-direction: row;
    align-items: center;
    background-color: var(--col-parchment);
    border-radius: 10px;
    border-width: 2px;
    border-color: var(--col-parchment-edge);
    padding: 4px 10px 4px 6px;
    min-width: 64px;
}

.card-price-amount {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--col-ink);
}

.card-buy {
    background-color: var(--col-buy);
    color: rgb(255, 248, 232);
    -unity-font-style: bold;
    font-size: 14px;
    border-radius: 10px;
    border-width: 2px;
    border-color: var(--col-wood-dark);
    padding: 6px 18px;
    margin: 0;
    transition-property: background-color, translate;
    transition-duration: 120ms;
}

.card-buy:hover {
    background-color: var(--col-buy-hover);
    translate: 0 -2px;
}

.card-buy:active {
    background-color: var(--col-buy-press);
    translate: 0 0;
}

.card-soldout {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--col-buy-press);
    background-color: var(--col-parchment);
    border-radius: 8px;
    border-width: 2px;
    border-color: var(--col-buy-press);
    padding: 4px 14px;
    letter-spacing: 2px;
    display: none;
    rotate: -8deg;
}

.material-card.sold-out .card-buy {
    display: none;
}

.material-card.sold-out .card-soldout {
    display: flex;
}

/* ------------ footer ------------------------------------------------- */
.market-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    padding: 8px 16px;
    background-color: var(--col-parchment-dark);
    border-radius: 14px;
    border-width: 2px;
    border-color: var(--col-parchment-edge);
    margin-top: 12px;
}

.market-status {
    font-size: 14px;
    color: var(--col-ink-soft);
    -unity-font-style: italic;
}

.market-proceed {
    background-color: var(--col-buy);
    color: rgb(255, 248, 232);
    -unity-font-style: bold;
    font-size: 16px;
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--col-wood-dark);
    padding: 10px 24px;
    margin: 0;
    letter-spacing: 1px;
    transition-property: background-color, translate, opacity;
    transition-duration: 120ms;
}

.market-proceed:hover {
    background-color: var(--col-buy-hover);
    translate: 0 -2px;
}

.market-proceed:disabled {
    background-color: rgb(180, 160, 130);
    color: rgb(230, 220, 200);
    border-color: rgb(150, 130, 100);
    opacity: 0.6;
}
