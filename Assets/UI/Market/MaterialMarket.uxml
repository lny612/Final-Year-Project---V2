<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="MaterialMarket.uss" />

    <ui:VisualElement name="market-root" class="market-root" picking-mode="Ignore">

        <!-- Wood plate + grain + edge vignette behind everything. -->
        <ui:VisualElement class="market-wood-plate"   picking-mode="Ignore" />
        <ui:VisualElement class="market-wood-grain"   picking-mode="Ignore" />
        <ui:VisualElement class="market-vignette"     picking-mode="Ignore" />

        <!-- ── Top bar: back · carved title plate · heart-and-coin gold ── -->
        <ui:VisualElement name="market-topbar" class="market-topbar">
            <ui:Button name="market-back" text="◀" class="market-back" />

            <ui:VisualElement class="market-title-plate">
                <ui:Label name="market-title" text="The Apothecary's Market" class="market-title" />
            </ui:VisualElement>

            <ui:VisualElement name="market-gold" class="market-gold">
                <ui:VisualElement class="market-gold-icon" picking-mode="Ignore" />
                <ui:Label name="gold-amount" text="0" class="gold-amount" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ── Body: left categories + memo · right scrollable card grid ── -->
        <ui:VisualElement class="market-body">

            <!-- LEFT column -->
            <ui:VisualElement name="market-left" class="market-left">

                <ui:VisualElement name="market-categories" class="market-categories">
                    <ui:Button name="cat-woods" class="market-cat market-cat--selected" text="Woods" />
                    <ui:VisualElement name="cat-divider" class="market-cat-divider hidden" picking-mode="Ignore" />
                    <ui:Button name="cat-cores" class="market-cat hidden" text="Cores" />
                </ui:VisualElement>

                <ui:VisualElement name="market-memo-panel" class="market-memo-panel">
                    <ui:Label class="memo-heading" text="The Customer" />
                    <ui:VisualElement class="memo-rule" picking-mode="Ignore" />

                    <ui:VisualElement class="memo-slot">
                        <ui:Label class="memo-label" text="Element" />
                        <ui:Label name="memo-element" class="memo-value" text="—" />
                    </ui:VisualElement>

                    <ui:VisualElement class="memo-slot">
                        <ui:Label class="memo-label" text="Personality" />
                        <ui:Label name="memo-personality" class="memo-value" text="—" />
                    </ui:VisualElement>

                    <ui:VisualElement class="memo-slot">
                        <ui:Label class="memo-label" text="Purpose" />
                        <ui:Label name="memo-purpose" class="memo-value" text="—" />
                    </ui:VisualElement>

                    <ui:VisualElement class="memo-slot">
                        <ui:Label class="memo-label" text="Reinforce / Conceal" />
                        <ui:Label name="memo-reinforcement" class="memo-value" text="—" />
                    </ui:VisualElement>

                    <ui:Label class="memo-footnote" text="✦ glyph hints when a material aligns with your memo." />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- RIGHT scrollable cards. Woods are visible at scene load; cores
                 stay hidden until the player buys a wood (then MaterialMarketUI
                 toggles the `hidden` class on `cat-cores` + `core-row`).
                 Horizontal scrolling is disabled — the three cards fit the
                 row width without overflow. -->
            <ui:ScrollView name="market-cards" class="market-cards"
                           horizontal-scroller-visibility="Hidden"
                           vertical-scroller-visibility="Auto">
                <ui:VisualElement name="wood-row" class="market-card-row" />
                <ui:VisualElement name="core-row" class="market-card-row hidden" />
            </ui:ScrollView>
        </ui:VisualElement>

        <!-- ── Footer: status + proceed ────────────────────────────── -->
        <ui:VisualElement class="market-footer">
            <ui:Label name="market-status" class="market-status" text="Waiting..." />
            <ui:Button name="market-proceed" class="market-proceed" text="To the Workbench" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
