<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement class="material-card">

        <ui:VisualElement class="card-nameplate">
            <ui:Label name="card-name" class="card-name" text="Material name" />
        </ui:VisualElement>

        <ui:Label name="card-subline" class="card-subline" text="— Core —" />

        <ui:VisualElement class="card-art">
            <ui:VisualElement name="card-placeholder" class="card-placeholder" picking-mode="Ignore" />
            <ui:VisualElement name="card-image"       class="card-image"       picking-mode="Ignore" />
            <ui:Label         name="card-hint-glyph"  class="card-hint-glyph"  text="✦" />
            <ui:Label         name="card-soldout"     class="card-soldout"     text="Bought" />
        </ui:VisualElement>

        <ui:VisualElement class="card-attributes">
            <ui:Label name="card-field1" class="card-field card-field-primary" text="" />
            <ui:Label name="card-field2" class="card-field" text="" />
            <ui:Label name="card-field3" class="card-field" text="" />
        </ui:VisualElement>

        <ui:VisualElement class="card-footer">
            <ui:VisualElement class="card-price">
                <ui:VisualElement class="card-coin-icon" picking-mode="Ignore" />
                <ui:Label name="card-price-amount" class="card-price-amount" text="0" />
            </ui:VisualElement>

            <ui:Button name="card-buy" class="card-buy" text="Buy" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
