/* ==========================================================================
   CraftingWorkbench.uss
   Cozy wandcrafter's bench: warm walnut woodgrain plate, parchment cards
   for the customer memo and inventory, and a glowing magic circle in the
   centre with three slot wells laid out as a triangle (wood at the apex,
   two cores at the base) — referencing Atelier-style alchemy circles.
   ========================================================================== */

/* ── Palette tokens ─────────────────────────────────────────────────────── */
:root {
    --wood-base:        rgb(72, 46, 28);
    --wood-deep:        rgb(54, 32, 18);
    --wood-shadow:      rgb(36, 22, 12);
    --wood-warm:        rgb(110, 72, 40);
    --wood-grain:       rgba(36, 22, 12, 0.32);

    --parchment-base:   rgb(232, 213, 178);
    --parchment-warm:   rgb(217, 192, 150);
    --parchment-deep:   rgb(190, 160, 112);
    --parchment-edge:   rgba(110, 78, 36, 0.55);

    --ink-dark:         rgb(46, 32, 22);
    --ink-soft:         rgb(86, 64, 44);
    --ink-faded:        rgba(46, 32, 22, 0.55);

    --brass:            rgb(190, 148, 70);
    --brass-soft:       rgba(190, 148, 70, 0.35);
    --brass-glow:       rgba(232, 188, 96, 0.55);
    --gold-leaf:        rgb(214, 178, 112);

    --magic-aura:       rgba(255, 198, 110, 0.35);
    --magic-deep:       rgba(120, 70, 24, 0.45);
    --magic-bright:     rgba(255, 232, 170, 0.85);
}

/* ── Root: full-screen plate ────────────────────────────────────────────── */
.root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(54, 32, 18);
    -unity-font-definition: url("project://database/Assets/Fonts/The%20Garden%20of%20Lights%20SDF%201.asset");
    -unity-font-style: normal;
}

/* Walnut plate base — warm, deep brown. */
.wood-plate {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgb(72, 46, 28);
}

/* Subtle vertical-grain plane, faked with a slightly darker mid-tone band. */
.wood-grain {
    position: absolute;
    left: 4%; right: 4%; top: 3%; bottom: 3%;
    background-color: rgba(36, 22, 12, 0.18);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color:  rgba(36, 22, 12, 0.35);
    border-right-color: rgba(36, 22, 12, 0.35);
    border-top-color:   rgba(36, 22, 12, 0.45);
    border-bottom-color: rgba(36, 22, 12, 0.45);
    border-radius: 6px;
}

/* Heavy edge vignette to make the bench feel framed in worn brass. */
.wood-vignette {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    border-left-width:   38px;
    border-right-width:  38px;
    border-top-width:    32px;
    border-bottom-width: 32px;
    border-left-color:   rgba(36, 22, 12, 0.65);
    border-right-color:  rgba(36, 22, 12, 0.65);
    border-top-color:    rgba(36, 22, 12, 0.55);
    border-bottom-color: rgba(36, 22, 12, 0.75);
}

/* ── Header ─────────────────────────────────────────────────────────────── */
.header {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-top: 60px;
    margin-bottom: 6px;
}

.header-title {
    color: rgb(232, 213, 178);
    font-size: 38px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    text-shadow: 1px 2px 4px rgba(20, 12, 4, 0.85);
}

.header-rule {
    width: 320px;
    height: 1px;
    background-color: rgba(214, 178, 112, 0.65);
    margin-top: 6px;
    margin-bottom: 6px;
    border-radius: 1px;
}

/* ── Workspace 3-column grid ────────────────────────────────────────────── */
.workspace {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
    padding-left: 56px;
    padding-right: 56px;
    padding-top: 8px;
    padding-bottom: 24px;
}

/* ── LEFT: customer memo card ───────────────────────────────────────────── */
.memo-column {
    width: 320px;
    flex-shrink: 0;
    align-items: center;
    justify-content: flex-start;
    padding-top: 10px;
}

.memo-card {
    width: 320px;
    padding-left: 22px;
    padding-right: 22px;
    padding-top: 22px;
    padding-bottom: 22px;
    background-color: rgb(232, 213, 178);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color:  rgba(110, 78, 36, 0.55);
    border-right-color: rgba(110, 78, 36, 0.55);
    border-top-color:   rgba(110, 78, 36, 0.55);
    border-bottom-color: rgba(110, 78, 36, 0.55);
    border-radius: 4px;
}

.memo-heading {
    color: rgb(46, 32, 22);
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.memo-rule {
    width: 80%;
    height: 1px;
    background-color: rgba(46, 32, 22, 0.45);
    align-self: center;
    margin-bottom: 10px;
    border-radius: 1px;
}

.memo-row {
    flex-direction: column;
    margin-top: 6px;
    margin-bottom: 6px;
}

.memo-key {
    color: rgba(86, 64, 44, 0.85);
    font-size: 14px;
    letter-spacing: 2px;
    -unity-font-style: italic;
    margin-bottom: 2px;
}

.memo-val {
    color: rgb(46, 32, 22);
    font-size: 18px;
    -unity-font-style: bold;
    white-space: normal;
}

/* Decorative corner pins — small brass studs at the parchment corners. */
.memo-pin {
    position: absolute;
    width: 10px;
    height: 10px;
    background-color: rgb(190, 148, 70);
    border-radius: 50%;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(36, 22, 12, 0.65);
    border-right-color: rgba(36, 22, 12, 0.65);
    border-top-color: rgba(36, 22, 12, 0.65);
    border-bottom-color: rgba(36, 22, 12, 0.65);
}
.memo-pin-tl { left: 8px;  top: 8px; }
.memo-pin-tr { right: 8px; top: 8px; }

/* ── CENTER: magic circle stage ─────────────────────────────────────────── */
.craft-column {
    flex-grow: 1;
    align-items: center;
    justify-content: flex-start;
    padding-top: 6px;
    padding-left: 24px;
    padding-right: 24px;
}

/* Stage scaled by 1.8: outer ring 460→828px (radius x1.8). Stage container
   grows proportionally so all child rings stay correctly nested.
   Stage center = (1044/2, 936/2) = (522, 468). Ring centers verified to
   land on stage center: e.g. .circle-outer left:108 + 828/2 = 522 ✓ */
.circle-stage {
    width: 1044px;
    height: 936px;
    align-items: center;
    justify-content: center;
    /* Visual-only 30% downscale around the stage center. The layout box stays
       1044x936 so the confirm button + status text below don't reflow; only
       the rings/spokes/slots/labels inside shrink uniformly. */
    scale: 0.7 0.7;
}

/* Outer warm aura behind the circle — soft halo. */
.circle-glow {
    position: absolute;
    width: 972px;
    height: 972px;
    left: 36px;
    top: -18px;
    background-color: rgba(255, 198, 110, 0.18);
    border-radius: 50%;
}

/* Outer ring: thick brass border, hollow centre. */
.circle-outer {
    position: absolute;
    width: 828px;
    height: 828px;
    left: 108px;
    top: 54px;
    background-color: rgba(36, 22, 12, 0.0);
    border-left-width:   3px;
    border-right-width:  3px;
    border-top-width:    3px;
    border-bottom-width: 3px;
    border-left-color:   rgba(214, 178, 112, 0.85);
    border-right-color:  rgba(214, 178, 112, 0.85);
    border-top-color:    rgba(214, 178, 112, 0.85);
    border-bottom-color: rgba(214, 178, 112, 0.85);
    border-radius: 50%;
}

/* Rune-band ring: faux-rune rhythm faked with a translucent dashed-ish look
   — we layer two more circles at differing opacities. */
.circle-runes {
    position: absolute;
    width: 778px;
    height: 778px;
    left: 133px;
    top: 79px;
    background-color: rgba(255, 198, 110, 0.06);
    border-left-width:   1px;
    border-right-width:  1px;
    border-top-width:    1px;
    border-bottom-width: 1px;
    border-left-color:   rgba(255, 232, 170, 0.45);
    border-right-color:  rgba(255, 232, 170, 0.45);
    border-top-color:    rgba(255, 232, 170, 0.45);
    border-bottom-color: rgba(255, 232, 170, 0.45);
    border-radius: 50%;
}

/* Middle ring */
.circle-middle {
    position: absolute;
    width: 648px;
    height: 648px;
    left: 198px;
    top: 144px;
    background-color: rgba(120, 70, 24, 0.18);
    border-left-width:   2px;
    border-right-width:  2px;
    border-top-width:    2px;
    border-bottom-width: 2px;
    border-left-color:   rgba(214, 178, 112, 0.65);
    border-right-color:  rgba(214, 178, 112, 0.65);
    border-top-color:    rgba(214, 178, 112, 0.65);
    border-bottom-color: rgba(214, 178, 112, 0.65);
    border-radius: 50%;
}

/* Inner ring */
.circle-inner {
    position: absolute;
    width: 540px;
    height: 540px;
    left: 252px;
    top: 198px;
    background-color: rgba(120, 70, 24, 0.10);
    border-left-width:   1px;
    border-right-width:  1px;
    border-top-width:    1px;
    border-bottom-width: 1px;
    border-left-color:   rgba(255, 232, 170, 0.35);
    border-right-color:  rgba(255, 232, 170, 0.35);
    border-top-color:    rgba(255, 232, 170, 0.35);
    border-bottom-color: rgba(255, 232, 170, 0.35);
    border-radius: 50%;
}

/* Star-like central plate (square rotated 45° gives a diamond) — a stand-in
   for an alchemy sigil. Layered behind the heart. */
.circle-star {
    position: absolute;
    width: 324px;
    height: 324px;
    left: 360px;
    top: 306px;
    background-color: rgba(120, 70, 24, 0.16);
    rotate: 45deg;
    border-left-width:   2px;
    border-right-width:  2px;
    border-top-width:    2px;
    border-bottom-width: 2px;
    border-left-color:   rgba(214, 178, 112, 0.55);
    border-right-color:  rgba(214, 178, 112, 0.55);
    border-top-color:    rgba(214, 178, 112, 0.55);
    border-bottom-color: rgba(214, 178, 112, 0.55);
}

/* Bright cream centre disc — the "mouth" of the circle. */
.circle-heart {
    position: absolute;
    width: 144px;
    height: 144px;
    left: 450px;
    top: 396px;
    background-color: rgba(255, 232, 170, 0.55);
    border-left-width:   2px;
    border-right-width:  2px;
    border-top-width:    2px;
    border-bottom-width: 2px;
    border-left-color:   rgba(214, 178, 112, 0.85);
    border-right-color:  rgba(214, 178, 112, 0.85);
    border-top-color:    rgba(214, 178, 112, 0.85);
    border-bottom-color: rgba(214, 178, 112, 0.85);
    border-radius: 50%;
}

/* Triangle spokes — thin warm gold lines that link the centre to each slot.
   Drawn as 1×length blocks rotated to point at each vertex. */
.spoke {
    position: absolute;
    width: 2px;
    height: 324px;
    background-color: rgba(214, 178, 112, 0.55);
    left: 521px;
    top: 144px;
}
.spoke-top { rotate:    0deg; }
.spoke-bl  { rotate:  120deg; top: 396px; left: 521px; }
.spoke-br  { rotate: -120deg; top: 396px; left: 521px; }

/* ── Slots: triangular vertices around the circle ───────────────────────── */
.slot {
    position: absolute;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    width: 228px;
}

/* Triangle vertices inside the 1044×936 stage. Each slot is anchored by its
   centre — translate compensates for the slot's own width/height. Top/bottom
   offsets scaled with the stage; left/right percentages auto-scale. */
.slot-top { top:    14px; left: 50%; translate: -50%   0; }
.slot-bl  { bottom:  11px; left: 14%; translate:   0%   0; }
.slot-br  { bottom:  11px; right: 14%; translate:  0%   0; }

.slot-tag {
    color: rgb(232, 213, 178);
    font-size: 13px;
    letter-spacing: 3px;
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
    text-shadow: 1px 1px 3px rgba(20, 12, 4, 0.85);
}

/* The slot-well is the round inset where the material image lives.
   Scaled by 1.5: 116→174, 100→150, 92→138. Offsets recomputed so children
   stay centered: rim-inner (174-150)/2 = 12; slot-image (174-138)/2 = 18. */
.slot-well {
    width: 174px;
    height: 174px;
    align-items: center;
    justify-content: center;
}

.slot-rim-outer {
    position: absolute;
    width: 174px;
    height: 174px;
    left: 0;
    top: 0;
    background-color: rgb(54, 32, 18);
    border-left-width:   3px;
    border-right-width:  3px;
    border-top-width:    3px;
    border-bottom-width: 3px;
    border-left-color:   rgb(214, 178, 112);
    border-right-color:  rgb(214, 178, 112);
    border-top-color:    rgb(214, 178, 112);
    border-bottom-color: rgb(214, 178, 112);
    border-radius: 50%;
}

.slot-rim-inner {
    position: absolute;
    width: 150px;
    height: 150px;
    left: 12px;
    top: 12px;
    background-color: rgba(36, 22, 12, 0.85);
    border-left-width:   1px;
    border-right-width:  1px;
    border-top-width:    1px;
    border-bottom-width: 1px;
    border-left-color:   rgba(190, 148, 70, 0.65);
    border-right-color:  rgba(190, 148, 70, 0.65);
    border-top-color:    rgba(190, 148, 70, 0.65);
    border-bottom-color: rgba(190, 148, 70, 0.65);
    border-radius: 50%;
}

/* Material thumbnail — image assigned at runtime. */
.slot-image {
    position: absolute;
    width: 138px;
    height: 138px;
    left: 18px;
    top: 18px;
    border-radius: 50%;
    -unity-background-scale-mode: scale-and-crop;
}

.slot-empty {
    color: rgba(214, 178, 112, 0.55);
    font-size: 14px;
    -unity-font-style: italic;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.slot-name {
    color: rgb(232, 213, 178);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 6px;
    text-shadow: 1px 1px 3px rgba(20, 12, 4, 0.85);
}

/* Small × button — sits at the top-right of the well to clear the slot. */
.slot-clear {
    position: absolute;
    right: 6px;
    top:   6px;
    width: 22px;
    height: 22px;
    color: rgb(232, 213, 178);
    background-color: rgba(36, 22, 12, 0.75);
    background-image: none;
    border-left-width:   1px;
    border-right-width:  1px;
    border-top-width:    1px;
    border-bottom-width: 1px;
    border-left-color:   rgba(214, 178, 112, 0.65);
    border-right-color:  rgba(214, 178, 112, 0.65);
    border-top-color:    rgba(214, 178, 112, 0.65);
    border-bottom-color: rgba(214, 178, 112, 0.65);
    border-radius: 50%;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    transition-property: color, background-color, scale;
    transition-duration: 120ms;
    transition-timing-function: ease-out;
}
.slot-clear:hover {
    color: rgb(255, 232, 170);
    background-color: rgba(36, 22, 12, 0.95);
    scale: 1.08 1.08;
}
.slot-clear:active { scale: 0.95 0.95; }

/* ── Confirm button ─────────────────────────────────────────────────────── */
.confirm-button {
    align-self: center;
    margin-top: 10px;
    color: rgb(46, 32, 22);
    background-color: rgb(214, 178, 112);
    background-image: none;
    border-left-width:   2px;
    border-right-width:  2px;
    border-top-width:    2px;
    border-bottom-width: 2px;
    border-left-color:   rgba(110, 78, 36, 0.65);
    border-right-color:  rgba(110, 78, 36, 0.65);
    border-top-color:    rgba(110, 78, 36, 0.65);
    border-bottom-color: rgba(110, 78, 36, 0.65);
    border-radius: 6px;
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 10px;
    padding-bottom: 10px;
    transition-property: color, background-color, scale, translate;
    transition-duration: 120ms;
    transition-timing-function: ease-out;
}
.confirm-button:hover {
    background-color: rgb(232, 196, 130);
    scale: 1.03 1.03;
}
.confirm-button:active {
    background-color: rgb(190, 148, 70);
    translate: 0 1px;
    scale: 0.98 0.98;
}
.confirm-button:disabled {
    color: rgba(46, 32, 22, 0.55);
    background-color: rgba(190, 148, 70, 0.45);
    border-left-color:   rgba(110, 78, 36, 0.35);
    border-right-color:  rgba(110, 78, 36, 0.35);
    border-top-color:    rgba(110, 78, 36, 0.35);
    border-bottom-color: rgba(110, 78, 36, 0.35);
}

/* ── Status text ───────────────────────────────────────────────────────── */
.status-text {
    margin-top: 14px;
    color: rgba(232, 213, 178, 0.85);
    font-size: 16px;
    -unity-font-style: italic;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    white-space: normal;
    text-shadow: 1px 1px 3px rgba(20, 12, 4, 0.85);
}

/* ── RIGHT: inventory column ────────────────────────────────────────────── */
.inventory-column {
    width: 320px;
    flex-shrink: 0;
    align-items: stretch;
    padding-top: 10px;
}

.inventory-card {
    flex-grow: 1;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 18px;
    padding-bottom: 18px;
    background-color: rgb(232, 213, 178);
    border-left-width:   2px;
    border-right-width:  2px;
    border-top-width:    2px;
    border-bottom-width: 2px;
    border-left-color:   rgba(110, 78, 36, 0.55);
    border-right-color:  rgba(110, 78, 36, 0.55);
    border-top-color:    rgba(110, 78, 36, 0.55);
    border-bottom-color: rgba(110, 78, 36, 0.55);
    border-radius: 4px;
}

.inventory-heading {
    color: rgb(46, 32, 22);
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.inventory-rule {
    width: 80%;
    height: 1px;
    background-color: rgba(46, 32, 22, 0.45);
    align-self: center;
    margin-bottom: 10px;
    border-radius: 1px;
}

.inventory-section {
    color: rgb(110, 78, 36);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-top: 8px;
    margin-bottom: 4px;
    padding-left: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(110, 78, 36, 0.35);
}

.inventory-scroll {
    flex-grow: 1;
    min-height: 100px;
    max-height: 280px;
}

.inventory-list {
    flex-direction: column;
    align-items: stretch;
}

/* Inventory row — one material per row, parchment-toned with a hover lift. */
.inv-row {
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    margin-top: 3px;
    margin-bottom: 3px;
    background-color: rgba(217, 192, 150, 0.65);
    border-left-width:   1px;
    border-right-width:  1px;
    border-top-width:    1px;
    border-bottom-width: 1px;
    border-left-color:   rgba(110, 78, 36, 0.45);
    border-right-color:  rgba(110, 78, 36, 0.45);
    border-top-color:    rgba(110, 78, 36, 0.45);
    border-bottom-color: rgba(110, 78, 36, 0.45);
    border-radius: 4px;
    color: rgb(46, 32, 22);
    -unity-text-align: middle-left;
    transition-property: background-color, translate;
    transition-duration: 120ms;
    transition-timing-function: ease-out;
}
.inv-row:hover {
    background-color: rgba(232, 213, 178, 0.95);
    translate: 0 -1px;
}
.inv-row:active {
    background-color: rgba(190, 160, 112, 0.85);
    translate: 0 1px;
}

.inv-row-thumb {
    width: 36px;
    height: 36px;
    margin-right: 10px;
    background-color: rgba(54, 32, 18, 0.45);
    border-left-width:   1px;
    border-right-width:  1px;
    border-top-width:    1px;
    border-bottom-width: 1px;
    border-left-color:   rgba(110, 78, 36, 0.65);
    border-right-color:  rgba(110, 78, 36, 0.65);
    border-top-color:    rgba(110, 78, 36, 0.65);
    border-bottom-color: rgba(110, 78, 36, 0.65);
    border-radius: 4px;
    -unity-background-scale-mode: scale-and-crop;
}

.inv-row-text {
    flex-grow: 1;
    flex-direction: column;
    align-items: stretch;
}

.inv-row-name {
    color: rgb(46, 32, 22);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
}

.inv-row-price {
    color: rgba(86, 64, 44, 0.85);
    font-size: 11px;
    -unity-font-style: italic;
    letter-spacing: 1px;
    -unity-text-align: middle-left;
}

.inv-empty {
    color: rgba(86, 64, 44, 0.65);
    font-size: 13px;
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    padding-top: 12px;
    padding-bottom: 12px;
}

/* ── Result modal ──────────────────────────────────────────────────────── */
.result-modal {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center;
    justify-content: center;
}

.result-modal.hidden {
    display: none;
}

.modal-backdrop {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(20, 12, 4, 0.78);
}

.result-card {
    width: 760px;
    padding-left: 36px;
    padding-right: 36px;
    padding-top: 28px;
    padding-bottom: 24px;
    background-color: rgb(232, 213, 178);
    border-left-width:   3px;
    border-right-width:  3px;
    border-top-width:    3px;
    border-bottom-width: 3px;
    border-left-color:   rgba(110, 78, 36, 0.85);
    border-right-color:  rgba(110, 78, 36, 0.85);
    border-top-color:    rgba(110, 78, 36, 0.85);
    border-bottom-color: rgba(110, 78, 36, 0.85);
    border-radius: 6px;
    align-items: stretch;
    justify-content: flex-start;
}

.result-title {
    color: rgb(46, 32, 22);
    font-size: 32px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
    white-space: normal;
}

.result-rule {
    width: 80%;
    height: 1px;
    background-color: rgba(46, 32, 22, 0.45);
    align-self: center;
    margin-bottom: 14px;
    border-radius: 1px;
}

.result-body {
    flex-direction: row;
    align-items: stretch;
}

.result-image-frame {
    width: 240px;
    height: 240px;
    margin-right: 20px;
    background-color: rgba(54, 32, 18, 0.85);
    border-left-width:   3px;
    border-right-width:  3px;
    border-top-width:    3px;
    border-bottom-width: 3px;
    border-left-color:   rgba(214, 178, 112, 0.85);
    border-right-color:  rgba(214, 178, 112, 0.85);
    border-top-color:    rgba(214, 178, 112, 0.85);
    border-bottom-color: rgba(214, 178, 112, 0.85);
    border-radius: 4px;
    flex-shrink: 0;
    align-items: stretch;
    justify-content: stretch;
}

.result-image {
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
}

.result-meta {
    flex-grow: 1;
    flex-direction: column;
    align-items: stretch;
}

.result-desc {
    color: rgb(46, 32, 22);
    font-size: 15px;
    white-space: normal;
    margin-bottom: 12px;
}

.result-attribs-heading {
    color: rgb(110, 78, 36);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-top: 6px;
    margin-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(110, 78, 36, 0.45);
}

.result-attribs {
    color: rgb(46, 32, 22);
    font-size: 14px;
    white-space: normal;
}

.proceed-button {
    align-self: center;
    margin-top: 18px;
    color: rgb(46, 32, 22);
    background-color: rgb(214, 178, 112);
    background-image: none;
    border-left-width:   2px;
    border-right-width:  2px;
    border-top-width:    2px;
    border-bottom-width: 2px;
    border-left-color:   rgba(110, 78, 36, 0.65);
    border-right-color:  rgba(110, 78, 36, 0.65);
    border-top-color:    rgba(110, 78, 36, 0.65);
    border-bottom-color: rgba(110, 78, 36, 0.65);
    border-radius: 6px;
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 10px;
    padding-bottom: 10px;
    transition-property: color, background-color, scale, translate;
    transition-duration: 120ms;
    transition-timing-function: ease-out;
}
.proceed-button:hover {
    background-color: rgb(232, 196, 130);
    scale: 1.03 1.03;
}
.proceed-button:active {
    background-color: rgb(190, 148, 70);
    translate: 0 1px;
    scale: 0.98 0.98;
}
