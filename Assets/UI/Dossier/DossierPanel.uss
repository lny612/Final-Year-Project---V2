/*
 * DossierPanel.uss
 *
 * Cozy magical-fantasy parchment dossier styling.
 * Palette:
 *   warm dark wood       #3E2D1F  (backdrop fill)
 *   warm wood mid        #6B4A2E  (panel borders, body text)
 *   parchment cream      #F4E5C2  (panel fill)
 *   parchment shadow     #E8D4A8  (inner shaded edges)
 *   gold light           #C9A96E  (corner ornaments)
 *   gold deep            #B8945C  (inner gold rule)
 *   wax-seal red         #7A2E1F  (memo seal, primary button)
 *   ink blue             #2E558C  (clickable words)
 *   armed amber          #C58A1F  (currently armed word)
 *   used grey            #888888  (committed words)
 *
 * Font: reuses LiberationSans (TMP's underlying TTF) for now.
 * To swap to a custom serif later, drop a TTF into Assets/UI/Dossier/Fonts/
 * and edit the single `-unity-font-definition` line in `.root`.
 */

.root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    -unity-font-definition: url("project://database/Assets/Fonts/The%20Garden%20of%20Lights.ttf");
    color: rgb(62, 45, 31);
    font-size: 16px;
}

/* ── Wood backdrop ───────────────────────────────────────────── */

.wood-frame {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: rgb(62, 45, 31);
}

/* ── Parchment panel ─────────────────────────────────────────── */

.parchment-panel {
    position: absolute;
    top: 36px;
    right: 36px;
    bottom: 100px;
    left: 36px;
    background-color: rgb(244, 229, 194);
    border-color: rgb(107, 74, 46);
    border-width: 2px;
    border-radius: 6px;
    padding: 36px 32px 28px 32px;
    flex-direction: column;
    overflow: hidden;
}

.parchment-inner-border {
    position: absolute;
    top: 14px;
    right: 14px;
    bottom: 14px;
    left: 14px;
    background-color: rgba(0, 0, 0, 0);
    border-color: rgb(184, 148, 92);
    border-width: 1px;
    border-radius: 4px;
}

/* ── Gold corner ornaments ───────────────────────────────────── */
/* Each corner is 28×28; an inner 18×18 child draws the carved double-edge. */

.gold-corner {
    position: absolute;
    width: 32px;
    height: 32px;
    background-color: rgb(201, 169, 110);
    border-color: rgb(107, 74, 46);
    border-width: 2px;
    align-items: center;
    justify-content: center;
}

.gold-corner__inner {
    width: 14px;
    height: 14px;
    background-color: rgb(184, 148, 92);
    border-color: rgb(107, 74, 46);
    border-width: 1px;
    rotate: 45deg;
}

.gold-corner--tl {
    top: 8px;
    left: 8px;
    border-top-left-radius: 8px;
    border-bottom-right-radius: 12px;
}

.gold-corner--tr {
    top: 8px;
    right: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 12px;
}

.gold-corner--bl {
    bottom: 8px;
    left: 8px;
    border-bottom-left-radius: 8px;
    border-top-right-radius: 12px;
}

.gold-corner--br {
    bottom: 8px;
    right: 8px;
    border-bottom-right-radius: 8px;
    border-top-left-radius: 12px;
}

/* ── Two-column layout inside the parchment ──────────────────── */

.content-row {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
}

/* ── Dossier (left column) ───────────────────────────────────── */

.dossier-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin-right: 20px;
}

.dossier-column {
    flex-direction: column;
    padding: 4px 12px 4px 4px;
}

.dossier-heading {
    font-size: 22px;
    color: rgb(140, 100, 60);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    letter-spacing: 6px;
    margin-bottom: 6px;
}

.dossier-name {
    font-size: 50px;
    color: rgb(62, 45, 31);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    margin-bottom: 12px;
    white-space: normal;
}

.dossier-divider {
    height: 1px;
    background-color: rgb(184, 148, 92);
    margin: 4px 24px 22px 24px;
}

.dossier-section {
    flex-direction: column;
    margin-bottom: 22px;
}

/* Used to be 'quiet' (faded) for CONSTRAINT — now matches the other sections. */
.dossier-section--quiet {
    opacity: 1;
}

.dossier-section-title {
    font-size: 28px;
    color: rgb(122, 46, 31);
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 8px;
}

.dossier-static-prose {
    font-size: 24px;
    color: rgb(62, 45, 31);
    -unity-font-style: normal;
    white-space: normal;
    padding-left: 4px;
}

/* The prose container: a flex-wrap row of word Buttons + plain Labels. */
.dossier-prose {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding-left: 4px;
}

/* ── Word Buttons (clickable content words) ──────────────────── */

.word-static {
    font-size: 24px;
    color: rgb(62, 45, 31);
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

/* Reads as plain prose at rest — the drag-highlight is the affordance,
   not a visible underline or ink-blue color. Padding/margin are kept for
   a comfortable hit area. */
.word-clickable {
    font-size: 24px;
    color: rgb(62, 45, 31);
    margin: 0 1px 0 0;
    padding: 0 2px 0 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    -unity-font-style: normal;
    transition-property: background-color;
    transition-duration: 120ms;
}

/* Highlighter-yellow swipe selection (drag-to-highlight). */
.word-highlighted {
    background-color: rgba(247, 220, 110, 0.55);
    color: rgb(62, 45, 31);
}

.word-highlighted:hover {
    background-color: rgba(247, 220, 110, 0.75);
    color: rgb(62, 45, 31);
}

/* No `.word-clickable:hover` rule — under root pointer-capture, UI Toolkit
   can leave :hover stuck on the word that was under the cursor at PointerDown,
   which would override `.word-highlighted` and break the yellow swipe on that
   one word. The base style already reads as plain prose; we don't need a
   hover variant. */
.word-clickable:focus {
    background-color: rgba(0, 0, 0, 0);
}

.word-armed {
    color: rgb(197, 138, 31);
    -unity-font-style: bold;
    border-bottom-width: 2px;
    border-bottom-color: rgb(197, 138, 31);
    background-color: rgba(197, 138, 31, 0.12);
}

.word-committed {
    color: rgb(136, 136, 136);
    border-bottom-width: 0;
}

.word-committed:hover {
    background-color: rgba(0, 0, 0, 0);
    color: rgb(136, 136, 136);
}

/* ── Memo card (right column) ────────────────────────────────── */

.memo-card {
    width: 560px;
    flex-shrink: 0;
    background-color: rgb(248, 235, 205);
    border-color: rgb(184, 148, 92);
    border-width: 1px;
    border-radius: 4px;
    padding: 28px 26px 28px 26px;
    flex-direction: column;
}

.memo-card__seal {
    position: absolute;
    top: -12px;
    right: 18px;
    width: 28px;
    height: 28px;
    background-color: rgb(122, 46, 31);
    border-color: rgb(70, 22, 14);
    border-width: 2px;
    border-radius: 14px;
}

.memo-card__title {
    font-size: 36px;
    color: rgb(62, 45, 31);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    margin-bottom: 8px;
}

.memo-card__hint {
    font-size: 18px;
    color: rgb(140, 110, 80);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 18px;
}

.memo-row {
    flex-direction: column;
    margin-bottom: 22px;
}

.memo-row__prompt {
    font-size: 22px;
    color: rgb(122, 46, 31);
    -unity-font-style: italic;
    white-space: normal;
    margin-bottom: 8px;
    padding-left: 4px;
}

/* Memo slot is now a flex-wrap container that holds N chips. */
.memo-slot {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    align-content: flex-start;
    background-color: rgb(244, 229, 194);
    border-color: rgb(184, 148, 92);
    border-width: 1px;
    border-bottom-width: 2px;
    border-radius: 3px;
    padding: 8px 8px 8px 8px;
    min-height: 44px;
    transition-property: background-color, border-color, translate;
    transition-duration: 120ms;
}

.memo-slot:hover {
    background-color: rgb(252, 240, 215);
    border-color: rgb(201, 169, 110);
}

/* Soft drop-target glow when a drag is hovering the slot. */
.memo-slot--drop-target {
    background-color: rgb(252, 240, 215);
    border-color: rgb(197, 138, 31);
    border-width: 2px;
    border-bottom-width: 2px;
}

.memo-slot--filled {
    background-color: rgb(252, 240, 215);
    border-bottom-color: rgb(122, 46, 31);
}

/* Empty-state hint shown when a slot has no chips yet. */
.memo-slot__placeholder {
    font-size: 18px;
    color: rgba(122, 46, 31, 0.55);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    flex-grow: 1;
    padding: 6px 4px 6px 4px;
}

/* One chip = one committed entry (word or phrase). */
.memo-chip {
    flex-direction: row;
    align-items: center;
    background-color: rgb(244, 229, 194);
    border-color: rgb(184, 148, 92);
    border-width: 1px;
    border-radius: 3px;
    padding: 4px 6px 4px 8px;
    margin: 3px 4px 3px 0;
    transition-property: background-color, border-color;
    transition-duration: 100ms;
}

.memo-chip:hover {
    background-color: rgb(252, 240, 215);
    border-color: rgb(201, 169, 110);
}

.memo-chip__text {
    font-size: 22px;
    color: rgb(62, 45, 31);
    -unity-font-style: bold;
    margin-right: 6px;
}

.memo-chip__remove {
    font-size: 18px;
    color: rgb(122, 46, 31);
    -unity-font-style: bold;
    background-color: rgba(122, 46, 31, 0.08);
    border-color: rgba(122, 46, 31, 0.15);
    border-width: 1px;
    border-radius: 10px;
    padding: 0 7px 0 7px;
    margin-left: 4px;
    min-width: 22px;
    -unity-text-align: middle-center;
}

.memo-chip__remove:hover {
    background-color: rgba(122, 46, 31, 0.20);
    color: rgb(255, 240, 210);
}

/* Drag-ghost element that follows the cursor while dragging a highlighted run. */
.drag-ghost {
    position: absolute;
    background-color: rgba(252, 240, 215, 0.95);
    border-color: rgb(197, 138, 31);
    border-width: 1px;
    border-radius: 3px;
    padding: 4px 8px 4px 8px;
    font-size: 16px;
    color: rgb(62, 45, 31);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: nowrap;
    opacity: 0.92;
}

/* ── Status bar / primary buttons ────────────────────────────── */

.status-bar {
    position: absolute;
    bottom: 16px;
    left: 36px;
    right: 36px;
    height: 68px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(78, 56, 38);
    border-color: rgb(201, 169, 110);
    border-width: 1px;
    border-radius: 4px;
    padding: 0 16px 0 22px;
}

.status-label {
    font-size: 20px;
    color: rgb(244, 229, 194);
    -unity-font-style: italic;
}

.status-bar__spacer {
    flex-grow: 1;
}

.primary-button {
    font-size: 20px;
    color: rgb(244, 229, 194);
    -unity-font-style: bold;
    background-color: rgb(122, 46, 31);
    border-color: rgb(201, 169, 110);
    border-width: 1px;
    border-radius: 4px;
    padding: 12px 24px 12px 24px;
    margin-left: 12px;
    letter-spacing: 1px;
    transition-property: background-color, color;
    transition-duration: 120ms;
}

.primary-button:hover {
    background-color: rgb(150, 60, 38);
}

.primary-button:disabled {
    background-color: rgb(94, 70, 50);
    color: rgb(180, 160, 130);
}

.primary-button--ghost {
    background-color: rgba(244, 229, 194, 0.08);
    color: rgb(244, 229, 194);
}

.primary-button--ghost:hover {
    background-color: rgba(244, 229, 194, 0.18);
}

/* ── Ink-blot pop element (created at runtime by the controller) ─ */

.ink-blot {
    position: absolute;
    width: 14px;
    height: 14px;
    background-color: rgb(31, 31, 46);
    border-radius: 7px;
    left: 8px;
    top: 8px;
    opacity: 0.85;
}
