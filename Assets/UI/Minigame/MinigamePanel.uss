/* ==========================================================================
   MinigamePanel.uss
   Cozy magical-fantasy chrome that frames the procedural rune-tracing
   gameplay (TracingMinigameUI). All chrome elements use picking-mode="Ignore"
   so mouse input falls through to the gameplay layer.

   Visual references:
     • Hogwarts Legacy spell-tracing UI ("REVELIO" / "LEVIOSO" plates)
     • Potion Craft cozy walnut-and-parchment workspace
     • Project's own Title / Morning / Dossier panels (gold corners + parchment)

   Palette:
     ink deep            #0B0814  (radial centre / deepest backdrop)
     ink mid             #1B1626  (mid wash)
     walnut dark         #2A1C12  (wood frame)
     walnut warm         #4A2F1F  (wood frame inner)
     gold light          #E5C57A  (title text + flourishes)
     gold deep           #B8945C  (frame edges, brackets)
     parchment cream     #F4E5C2  (instruction text + key glyph face)
     wax-seal red        #7A2E1F  (round chip ink)
     ember red           #AA3C32  (kept for trail accents)
     rune blue           #78B4FF  (kept for trail accents)
========================================================================== */

.root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    -unity-font-definition: url("project://database/Assets/Fonts/The%20Garden%20of%20Lights%20SDF%201.asset");
    color: rgb(244, 229, 194);
    font-size: 14px;
}

/* ── Backdrop layers ───────────────────────────────────────────── */
/* Three stacked elements approximate a soft radial vignette plus a
   warm halo behind the gameplay (USS has no radial gradient). */

.ink-layer {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgb(11, 8, 20);
}

/* Soft warm halo a third of the way down — gives the path some "candle". */
.halo-layer {
    position: absolute;
    left: 12%;  right: 12%;
    top:  10%;  bottom: 16%;
    background-color: rgba(45, 30, 22, 0.55);
    border-radius: 320px;
}

/* Walnut wood frame (just outside the halo so it reads as a heavy slab). */
.wood-frame {
    position: absolute;
    left:  18px;  right:  18px;
    top:   18px;  bottom: 18px;
    background-color: rgba(0, 0, 0, 0);
    border-color: rgb(42, 28, 18);
    border-width: 14px;
    border-radius: 12px;
    /* Inner edge tone — fakes a bevel via outline. */
    box-shadow: 0 0 0 2px rgba(74, 47, 31, 0.85);
}

/* Outer-edge vignette darkens the corners further. */
.vignette-edge {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    border-left-width:   90px;
    border-right-width:  90px;
    border-top-width:    70px;
    border-bottom-width: 80px;
    border-left-color:   rgba(0, 0, 0, 0.45);
    border-right-color:  rgba(0, 0, 0, 0.45);
    border-top-color:    rgba(0, 0, 0, 0.30);
    border-bottom-color: rgba(0, 0, 0, 0.55);
}

/* ── Title bar: ✦ SPELL NAME ✦ ─────────────────────────────────── */

.title-frame {
    position: absolute;
    top: 36px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 28px;
}

.rule {
    width: 110px;
    height: 1px;
    background-color: rgba(184, 148, 92, 0.75);
}

.rule--left  { margin-right: 12px; }
.rule--right { margin-left:  12px; }

.title-glyph {
    color: rgb(229, 197, 122);
    font-size: 16px;
    margin: 0 6px;
    -unity-text-align: middle-center;
    text-shadow: 0 0 10px rgba(229, 197, 122, 0.45);
}

.title-label {
    color: rgb(244, 229, 194);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 8px;
    margin: 0 12px;
    text-shadow: 0 0 14px rgba(229, 197, 122, 0.55);
}

/* ── Round badge (top-right) ───────────────────────────────────── */

.round-badge {
    position: absolute;
    top: 36px;
    right: 44px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(244, 229, 194);
    border-color: rgb(107, 74, 46);
    border-width: 2px;
    border-radius: 6px;
    padding: 6px 14px 6px 14px;
}

.round-badge-corner {
    position: absolute;
    width: 8px;
    height: 8px;
    background-color: rgb(184, 148, 92);
    border-color: rgb(46, 32, 22);
    border-width: 1px;
    border-radius: 1px;
}
.round-badge-corner--tl { left:  4px; top:    4px; }
.round-badge-corner--tr { right: 4px; top:    4px; }
.round-badge-corner--bl { left:  4px; bottom: 4px; }
.round-badge-corner--br { right: 4px; bottom: 4px; }

.round-prefix {
    color: rgb(122, 46, 31);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-right: 8px;
    -unity-text-align: middle-center;
}

.round-label {
    color: rgb(46, 32, 22);
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

/* ── Play-area inset + gold corner brackets ────────────────────── */

.play-frame {
    position: absolute;
    top: 92px; right: 56px;
    bottom: 180px; left: 56px;
    background-color: rgba(0, 0, 0, 0);
}

/* Each bracket = an L-shaped pair of borders (only two sides set). */
.bracket {
    position: absolute;
    width: 36px;
    height: 36px;
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(184, 148, 92, 0.85);
}

.bracket--tl {
    top: 0;  left: 0;
    border-top-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 6px;
}
.bracket--tr {
    top: 0;  right: 0;
    border-top-width: 2px;
    border-right-width: 2px;
    border-top-right-radius: 6px;
}
.bracket--bl {
    bottom: 0; left: 0;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-bottom-left-radius: 6px;
}
.bracket--br {
    bottom: 0; right: 0;
    border-bottom-width: 2px;
    border-right-width: 2px;
    border-bottom-right-radius: 6px;
}

/* ── Instruction card (bottom-left) ────────────────────────────── */

.instruction-card {
    position: absolute;
    left:   60px;
    bottom: 56px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(14, 10, 18, 0.78);
    border-color: rgba(184, 148, 92, 0.55);
    border-width: 1px;
    border-radius: 6px;
    padding: 14px 22px 14px 16px;
    max-width: 480px;
    /* Subtle drop shadow so it lifts off the woodframe. */
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.55);
}

/* Tiny gold corner studs on the card — echoes the round badge & gold corners
   used elsewhere in the project. */
.card-corner {
    position: absolute;
    width: 6px;
    height: 6px;
    background-color: rgb(184, 148, 92);
    border-radius: 1px;
}
.card-corner--tl { left:  6px;  top:    6px; }
.card-corner--tr { right: 6px;  top:    6px; }
.card-corner--bl { left:  6px;  bottom: 6px; }
.card-corner--br { right: 6px;  bottom: 6px; }

/* Parchment "keycap" inside the card. */
.key-glyph {
    width: 44px;
    height: 44px;
    background-color: rgb(244, 229, 194);
    border-color: rgb(107, 74, 46);
    border-width: 2px;
    border-radius: 6px;
    align-items: center;
    justify-content: center;
    margin-right: 14px;
    flex-shrink: 0;
    /* Inner gold ring */
    box-shadow: inset 0 0 0 1px rgba(184, 148, 92, 0.85);
}

.key-glyph-label {
    color: rgb(46, 32, 22);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.instruction-text-col {
    flex-direction: column;
    flex-shrink: 1;
}

.instruction-label {
    color: rgb(244, 229, 194);
    font-size: 15px;
    -unity-text-align: middle-left;
    -unity-font-style: normal;
    letter-spacing: 1px;
    white-space: normal;
    margin-bottom: 2px;
}

.instruction-sub {
    color: rgba(244, 229, 194, 0.65);
    font-size: 12px;
    -unity-font-style: italic;
    -unity-text-align: middle-left;
    letter-spacing: 1px;
    white-space: normal;
}
