/*
 * MinigamePanel.uss
 *
 * Cozy magical-fantasy chrome for the wand-tracing minigame.
 * Sits BEHIND and AROUND the existing UGUI gameplay layer (path / cursor / gates / trail).
 *
 * Palette (matches Assets/UI references/mini game reference.png):
 *   ink black            #0E0C10  (vignette outer)
 *   midnight mist        #221E2C  (vignette mid)
 *   gold light           #E5C57A  (title text + flourish bars)
 *   gold deep            #B8945C  (frame borders, corner inners)
 *   parchment cream      #F4E5C2  (instruction text)
 *   wax-seal red         #7A2E1F  (round pill base, matches dossier accent)
 *   ember red            #AA3C32  (mist accent, kept available for future use)
 *   rune blue            #78B4FF  (trail accent, kept available for future use)
 *
 * Font: reuses LiberationSans (TMP's underlying TTF) for now.
 * To swap to a serif (EB Garamond / IM Fell English / Cardo) for stronger fantasy feel,
 * drop a TTF into Assets/UI/Minigame/Fonts/ and edit the `-unity-font-definition` line below.
 */

.root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf");
    color: rgb(244, 229, 194);
    font-size: 14px;
}

/* ── Vignette (dark moody backdrop) ───────────────────────────── */
/* Two stacked layers approximate a radial fade since USS has no radial gradient. */

.vignette-outer {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: rgb(14, 12, 16);
}

.vignette-inner {
    position: absolute;
    top: 8%;
    right: 8%;
    bottom: 8%;
    left: 8%;
    background-color: rgba(34, 30, 44, 0.70);
    border-radius: 200px;
}

/* ── Title bar (top-center, REVELIO with golden flourishes) ──── */

.title-frame {
    position: absolute;
    top: 28px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.title-label {
    font-size: 32px;
    color: rgb(229, 197, 122);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 12px;
    margin: 0 18px 0 18px;
    text-shadow: 0 0 14px rgba(229, 197, 122, 0.45);
}

/* Flourish: gold horizontal bar + diamond, mirrored on each side. */

.flourish {
    flex-direction: row;
    align-items: center;
    height: 14px;
}

.flourish__bar {
    width: 90px;
    height: 1px;
    background-color: rgb(184, 148, 92);
}

.flourish__diamond {
    width: 8px;
    height: 8px;
    background-color: rgb(229, 197, 122);
    border-color: rgb(184, 148, 92);
    border-width: 1px;
    rotate: 45deg;
    margin: 0 6px 0 6px;
}

/* ── Round pill (top right) ──────────────────────────────────── */

.round-pill {
    position: absolute;
    top: 28px;
    right: 36px;
    background-color: rgba(122, 46, 31, 0.85);
    border-color: rgb(201, 169, 110);
    border-width: 1px;
    border-radius: 14px;
    padding: 6px 18px 6px 18px;
}

.round-label {
    font-size: 14px;
    color: rgb(244, 229, 194);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 3px;
}

/* ── Play-area frame + gold corner ornaments ─────────────────── */
/* Transparent rectangle that visually frames the gameplay layer.
 * Matches DossierPanel's gold-corner pattern but inset further from the edges. */

.play-frame {
    position: absolute;
    top: 88px;
    right: 36px;
    bottom: 88px;
    left: 36px;
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(184, 148, 92, 0.55);
    border-width: 1px;
    border-radius: 6px;
}

.corner {
    position: absolute;
    width: 32px;
    height: 32px;
    background-color: rgb(201, 169, 110);
    border-color: rgb(107, 74, 46);
    border-width: 2px;
    align-items: center;
    justify-content: center;
}

.corner__inner {
    width: 14px;
    height: 14px;
    background-color: rgb(184, 148, 92);
    border-color: rgb(107, 74, 46);
    border-width: 1px;
    rotate: 45deg;
}

.corner--tl {
    top: -2px;
    left: -2px;
    border-top-left-radius: 8px;
    border-bottom-right-radius: 12px;
}

.corner--tr {
    top: -2px;
    right: -2px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 12px;
}

.corner--bl {
    bottom: -2px;
    left: -2px;
    border-bottom-left-radius: 8px;
    border-top-right-radius: 12px;
}

.corner--br {
    bottom: -2px;
    right: -2px;
    border-bottom-right-radius: 8px;
    border-top-left-radius: 12px;
}

/* ── Instruction bar (bottom center) ─────────────────────────── */

.instruction-bar {
    position: absolute;
    bottom: 28px;
    left: 0;
    right: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.instruction-rule {
    width: 80px;
    height: 1px;
    background-color: rgba(184, 148, 92, 0.65);
}

.instruction-rule--left {
    margin-right: 18px;
}

.instruction-rule--right {
    margin-left: 18px;
}

.instruction-label {
    font-size: 16px;
    color: rgb(244, 229, 194);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    text-shadow: 0 0 8px rgba(0, 0, 0, 0.65);
    max-width: 60%;
    white-space: normal;
}
